# Include these locations in the active www.amolbooks.com HTTPS server.
# All visitors receive the same server-rendered content inside the existing
# Angular host. Preserve the server's SSL, assets, uploads and feed locations.
# Replace existing product/package detail locations rather than duplicating them.

location = /robots.txt {
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://127.0.0.1:3000/api/robots.txt;
}

location = /sitemap.xml {
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://127.0.0.1:3000/api/sitemap.xml;
}

location = / {
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://127.0.0.1:3000/api/storefront-document/;
}

location = /product-list {
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://127.0.0.1:3000/api/storefront-document/product-list;
}

location = /category-list {
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://127.0.0.1:3000/api/storefront-document/category-list;
}

location = /author-list {
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://127.0.0.1:3000/api/storefront-document/author-list;
}

location = /publisher-list {
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://127.0.0.1:3000/api/storefront-document/publisher-list;
}

location = /blogs {
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://127.0.0.1:3000/api/storefront-document/blogs;
}

location = /offers {
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://127.0.0.1:3000/api/storefront-document/offers;
}

location = /contact-us {
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://127.0.0.1:3000/api/storefront-document/contact-us;
}

location ^~ /product-details/ {
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://127.0.0.1:3000/api/storefront-document/product-details/;
}

location ^~ /special-package-details/ {
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://127.0.0.1:3000/api/storefront-document/special-package-details/;
}

# Metadata refresh after Angular navigation; robots.txt already excludes /api/.
location ^~ /api/storefront-document/ {
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://127.0.0.1:3000;
}
